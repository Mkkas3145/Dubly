<Window x:Class="Dubly.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dubly 서버" Width="500" Height="590" MinWidth="480" MinHeight="580" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#F3F3F3">
  <Grid x:Name="Root" Margin="30,26,30,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="26"/><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><Border Width="40" Height="40" Background="#0067C0" CornerRadius="10" Margin="0,0,12,0"><TextBlock Text="D" Foreground="White" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Dubly" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="서버 실행기" FontSize="12" Foreground="#6B6B6B"/></StackPanel></StackPanel></StackPanel>
    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="10" Padding="18,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#989898" Margin="0,0,11,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="Status" Text="서버 꺼짐" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Text="설정을 입력하고 서버를 켜세요." Foreground="#6B6B6B" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
    <StackPanel Grid.Row="4" x:Name="SettingsPanel"><TextBlock Text="포트" FontSize="13" Margin="0,0,0,7"/><Border Background="White" CornerRadius="6" BorderBrush="#CCCCCC" BorderThickness="1,1,1,2"><TextBox x:Name="PortBox" Text="20806" MaxLength="5" AutomationProperties.Name="포트"/></Border><TextBlock Text="OpenRouter API 키" FontSize="13" Margin="0,20,0,7"/><Border Background="White" CornerRadius="6" BorderBrush="#CCCCCC" BorderThickness="1,1,1,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><PasswordBox x:Name="KeyBox" AutomationProperties.Name="OpenRouter API 키"/><TextBox x:Name="VisibleKeyBox" Visibility="Collapsed" AutomationProperties.Name="OpenRouter API 키 표시"/><Button x:Name="RevealButton" Grid.Column="1" Click="RevealKey" Padding="8" Background="Transparent" BorderThickness="0" AutomationProperties.Name="API 키 표시 또는 숨기기"><TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="16"/></Button></Grid></Border><TextBlock Text="키는 이 Windows 계정에 암호화해 저장합니다." Foreground="#777777" FontSize="11" Margin="1,8,0,0"/></StackPanel>
    <StackPanel Grid.Row="6"><TextBlock x:Name="ErrorText" Foreground="#C42B1C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/><Button x:Name="ToggleButton" Click="ToggleServer" Background="#0067C0" Foreground="White" BorderBrush="#005FB8" Padding="14,12" FontWeight="SemiBold"><TextBlock Text="서버 켜기" Foreground="White"/></Button><Button x:Name="OpenButton" Content="Dubly 열기  ↗" Click="OpenWebsite" IsEnabled="False" Margin="0,10,0,0" Padding="14,10"/></StackPanel>
  </Grid>
</Window>
